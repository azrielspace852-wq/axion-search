# ── AXION Search v4 ──────────────────────────────────────────
# Hanya untuk server.js (legacy Node lokal). Cloudflare Worker memakai wrangler vars/secrets.
PORT=3000

# 3 API Key Google AI Studio (rotasi otomatis)
AI_KEY_1=
AI_KEY_2=
AI_KEY_3=
AI_MODEL_DEFAULT=gemini-2.5-flash

# Brave Search API (opsional, gratis 2000 query/bulan) — menambah provider web
BRAVE_API_KEY=

# Timeout default per request (ms). Default 100000 = 100 detik, agar
# kombinasi multi-provider (rotasi + retry) punya waktu cukup berhasil.
TIMEOUT_MS=100000

# ── Proxy VPNX (anti-block Google/Bing) ──
# Fitur proxy berikut hanya tersedia pada server.js (legacy Node), bukan Cloudflare Workers native fetch.
# Container VPNX legacy menyediakan HTTP proxy di :8888. Set salah satu agar request Node memakai proxy.
# HTTPS_PROXY=http://localhost:8888
# HTTP_PROXY=http://localhost:8888
# VPNX_PROXY=http://localhost:8888

SILENT=1
SAFESEARCH_DEFAULT=1
PUBLIC_DOMAIN=https://search.xxn.cc.cd
