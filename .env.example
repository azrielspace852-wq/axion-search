# ── AXION Search ──────────────────────────────────────────────
# Salin file ini menjadi .env (lokal) atau simpan sebagai GitHub Secrets.
# JANGAN pernah commit file .env asli.

# Port server (internal, di belakang Cloudflare Tunnel)
PORT=3000

# 3 API Key Google AI Studio (rotasi otomatis). Ambil di https://aistudio.google.com/app/apikey
AI_KEY_1=
AI_KEY_2=
AI_KEY_3=

# Model AI default (bisa diubah user di Settings).
# Pilihan: gemini-3.1-flash-lite | gemini-3.5-flash-lite | gemma-4-31b-it | gemma-3-27b-it
AI_MODEL_DEFAULT=gemini-3.5-flash-lite

# Set 1 untuk mode senyap (tidak ada console output) — wajib untuk GitHub Actions.
SILENT=1

# SafeSearch default: 1 = aktif, 0 = nonaktif (user bisa ubah di Settings)
SAFESEARCH_DEFAULT=1

# Domain publik (untuk sitemap / opensearch / canonical)
PUBLIC_DOMAIN=https://axion-search.axn.cc.cd
