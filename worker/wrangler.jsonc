{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "axion-search-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.search.axn.cc.cd",
      "custom_domain": true
    }
  ],
  "vars": {
    "SITE_DOMAIN": "https://search.xxn.cc.cd",
    "SAFESEARCH_DEFAULT": "1",
    "SILENT": "1",
    "TIMEOUT_MS": "15000",
    "AI_MODEL_DEFAULT": "gemini-2.5-flash",
    "API_DOMAIN": "https://api.search.axn.cc.cd"
  }
}
